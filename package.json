    "build": "npm run validate && npx terser app.js -c -m -o app.min.js --source-map \"url='app.min.js.map'\" && npx terser supabase.js -c -m -o supabase.min.js --source-map \"url='supabase.min.js.map'\"",
    "audit": "node scripts/audit-supabase.mjs",
